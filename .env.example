# Sales Intelligence Agent — Environment Variables
# Copy this file to .env and fill in the values you want to use.
# All variables are OPTIONAL. The system runs on public sources with no API keys.

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal Access Token — raises rate limit from 60 to 5000 req/hr.
# Scopes needed: read:org, public_repo
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Contact Enrichment (free tier) ───────────────────────────────────────────
# Hunter.io — 25 free email searches/month
# https://hunter.io/api-keys
HUNTER_API_KEY=

# ── Future paid enrichment (leave blank until you purchase) ──────────────────
APOLLO_API_KEY=
CLAY_API_KEY=

# ── CRM live sync (leave blank to use JSON file exports only) ────────────────
HUBSPOT_API_KEY=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=
PIPEDRIVE_API_KEY=

# ── Notifications (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
GITHUB_REPO_URL=https://github.com/YOUR_USERNAME/sales-intelligence-agent
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
NOTIFICATION_EMAIL=

# ── System config ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10
REQUEST_RETRY_COUNT=3
MAX_AGE_SIGNALS_DAYS=90
DAILY_SCAN_COMPANY_LIMIT=50
