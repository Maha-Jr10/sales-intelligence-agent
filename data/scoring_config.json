{
  "schema_version": "2.0",
  "composite_weights": {
    "v1_score": 0.30,
    "intent_score": 0.40,
    "urgency_score": 0.30
  },
  "intent_scoring": {
    "signal_cluster_threshold": 3,
    "signal_cluster_window_days": 7,
    "signal_cluster_bonus": 12.0,
