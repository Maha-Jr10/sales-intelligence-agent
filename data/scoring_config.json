      "evaluating tools", "scaling infrastructure", "migration", "consolidate",
      "rebuild", "platform overhaul", "modernize", "vendor evaluation"
    ],
    "keyword_match_score": 3.0
  },
  "urgency_scoring": {
    "new_executive_window_days": 90,
    "new_executive_bonus": 15.0,
    "post_funding_window_days": 180,
    "post_funding_bonus": 12.0,
    "competitive_pressure_bonus": 10.0,
    "multiple_signals_same_day_bonus": 8.0,
    "correlation_boost_passthrough": true,
    "correlation_boost_cap": 30,
    "max_total_urgency_bonus": 50
  },
  "_urgency_cap_note": "urgency_raw = sum(individual bonuses) + min(correlation_boost, correlation_boost_cap). urgency_score = min(urgency_raw, max_total_urgency_bonus). Prevents leadership+funding+same-day+correlation accumulating beyond 50.",
  "priority_tiers": {
    "p1_threshold": 80,
